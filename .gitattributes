# Default: LF endings, auto-detect text
* text=auto eol=lf

# Force LF on files that MUST be LF (shell, Dockerfile, Python, YAML, etc.)
*.sh         text eol=lf
*.py         text eol=lf
*.toml       text eol=lf
*.yml        text eol=lf
*.yaml       text eol=lf
*.md         text eol=lf
Dockerfile   text eol=lf
*.env        text eol=lf
.env.example text eol=lf

# Binary
*.png binary
*.jpg binary
*.pdf binary
*.zip binary
*.gz  binary
