# --- Data (CLAUDE.md section 5) — gitignored entirely ---
data/
data/pdfs/
data/snapshots/
data/models/
data/*.duckdb
data/*.sqlite

# --- Artifacts (ad-hoc scratch) — but keep per-phase audit folders ---
# `artifacts/*` (not `artifacts/`) is required so git recurses into the
# directory and the negations below can re-include the per-phase folders.
artifacts/*
!artifacts/phase-*/

# --- Notebooks intermediates ---
*.ipynb_checkpoints/
