# --- Python ---
__pycache__/
*.py[cod]
*.pyc
*.egg-info/
*.egg
.Python
.venv/
venv/
.python-version

# --- Type checkers / linters / coverage ---
.mypy_cache/
.ruff_cache/
.pytest_cache/
htmlcov/
.coverage
.coverage.*
coverage.xml

# --- Build / packaging ---
build/
dist/

