# Copy to .env and fill. Never commit .env.

# ---- Core ----
ENV=dev
LOG_LEVEL=INFO
APP_VERSION=0.1.0

# ---- Postgres (used by docker-compose interpolation) ----
POSTGRES_USER=ede
POSTGRES_PASSWORD=ede
POSTGRES_DB=ede

# ---- Database / cache URLs ----
DATABASE_URL=postgresql+asyncpg://ede:ede@postgres:5432/ede
REDIS_URL=redis://redis:6379/0

# ---- API ----
EDE_API_TOKEN=changeme
API_HOST=0.0.0.0
API_PORT=8000

# ---- IBKR (phase 5) ----
IBKR_HOST=127.0.0.1
IBKR_PORT=7497
IBKR_CLIENT_ID=42
IBKR_PAPER=true

# ---- Anthropic / Analyst (phase 8) ----
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-4-7
ANALYST_DAILY_BUDGET_USD=2.00

# ---- GDELT BigQuery (phase 5) ----
GCP_SERVICE_ACCOUNT_JSON=
GCP_PROJECT_ID=

# ---- Discord (phase 11) ----
DISCORD_WEBHOOK_ALERTS=
DISCORD_WEBHOOK_DIGEST=

# ---- Obsidian sync (phase 8) ----
OBSIDIAN_VAULT_PATH=/mnt/obsidian/EDE

# ---- Scraping (phase 2+) ----
USER_AGENT=EDE-Bot/0.1 (research; contact@example.com)

# ---- ScrapingBee (phase 4: Consob — Radware bypass) ----
# Free Tier: 1000 calls/month, no credit card required.
# Sign up: https://app.scrapingbee.com/account/register
SCRAPINGBEE_API_KEY=your_scrapingbee_api_key_here
SCRAPINGBEE_MONTHLY_BUDGET=900   # hard limit (free tier = 1000)
SCRAPINGBEE_ALERT_THRESHOLDS=50,75,90   # Discord alert when usage % crosses these
